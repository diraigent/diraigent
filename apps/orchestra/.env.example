# ── Required ──────────────────────────────────────────────────────

# Diraigent API base URL
DIRAIGENT_API_URL=http://localhost:8082/v1

# Agent API key (dak_...) — issued by POST /v1/agents during onboard.
# Long-lived, no refresh needed.
DIRAIGENT_API_TOKEN=dak_...

# Agent UUID — set automatically by ./onboard.sh
AGENT_ID=<uuid>

# ── Optional ──────────────────────────────────────────────────────

# Base directory where project repos are located.
# Defaults to ~/diraigent/projects if not set.
# PROJECTS_PATH=/path/to/repos

# Max concurrent task workers (default: 3)
# MAX_WORKERS=3

# OpenCode is the default. Pick a connected provider/model for task and chat execution.
# OPENCODE_MODEL=openai/your-model-id
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Or run opencode auth login on this host.

# Persist this directory and back up its project-content.db with the central database.
# DATA_DIR=/path/to/orchestra-data

# Loki log shipping (omit to disable)
# LOKI_URL=http://localhost:3100
# LOKI_ENV=dev
