# Local Docker Compose setup. Copy to .env; keep credentials private.
# Prerequisites: Git, Docker Compose, Bash, curl and Python 3 (Linux or macOS).

# Development authentication. Services bind to localhost by default.
# For OIDC, remove DEV_USER_ID and configure the identity provider below.
DEV_USER_ID=00000000-0000-0000-0000-000000000001
# AUTH_ISSUER=https://auth.example.com/application/o/diraigent/
# AUTH_JWKS_URL=https://auth.example.com/application/o/diraigent/jwks/
# AUTH_PROVIDER_BASE=https://auth.example.com
# AUTH_CLIENT_ID=diraigent
# CORS_ORIGINS=https://app.example.com

# OpenCode is the default task provider. Choose an accessible provider/model.
# Set the matching API key, or run ./start.sh --login for interactive OAuth/key login.
# OPENCODE_MODEL=openai/your-model-id
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENCODE_API_KEY=

# Worker identity: generated and saved by start.sh on first registration.
# To reuse an agent from the web app, supply both its ID and agent API key.
# AGENT_NAME=orchestra-docker
# AGENT_ID=
# DIRAIGENT_API_TOKEN=
# For first registration against OIDC, use a user access token here.
# Remove it after the agent key has been saved; subsequent starts use that key.
# STARTUP_API_TOKEN=

# Concurrent task workers (default: 3).
# MAX_WORKERS=3
# Optional alternative execution providers, selected in task context.worker.provider.
# CLAUDE_CODE_OAUTH_TOKEN=
# CODEX_API_KEY=
# CODEX_ACCESS_TOKEN=

# Optional log shipping.
# LOKI_URL=http://loki:3100
# LOKI_ENV=dev
