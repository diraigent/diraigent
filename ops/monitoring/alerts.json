{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "Diraigent readiness",
      "folder": "Diraigent",
      "interval": "60s",
      "rules": [
        {
          "uid": "diraigent-telemetry-missing",
          "title": "Diraigent API telemetry missing",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "datasourceUid": "prometheus",
              "relativeTimeRange": {
                "to": 0,
                "from": 600
              },
              "model": {
                "refId": "A",
                "expr": "absent_over_time(http_server_request_count_total{service_name=\"diraigent-api\"}[5m]) or vector(0)",
                "instant": true,
                "range": false,
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "type": "query",
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "B"
                      ]
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "Alerting",
          "execErrState": "Alerting",
          "for": "2m",
          "labels": {
            "service": "diraigent-api",
            "severity": "warning"
          },
          "annotations": {
            "summary": "Diraigent API telemetry missing"
          }
        },
        {
          "uid": "diraigent-server-errors",
          "title": "Diraigent API server errors",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "datasourceUid": "prometheus",
              "relativeTimeRange": {
                "to": 0,
                "from": 600
              },
              "model": {
                "refId": "A",
                "expr": "sum(increase(http_server_request_count_total{service_name=\"diraigent-api\",http_status_code=~\"5..\"}[5m])) or vector(0)",
                "instant": true,
                "range": false,
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "type": "query",
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        2
                      ]
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "B"
                      ]
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "Alerting",
          "execErrState": "Alerting",
          "for": "2m",
          "labels": {
            "service": "diraigent-api",
            "severity": "warning"
          },
          "annotations": {
            "summary": "Diraigent API server errors"
          }
        },
        {
          "uid": "diraigent-latency",
          "title": "Diraigent API p95 latency high",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "datasourceUid": "prometheus",
              "relativeTimeRange": {
                "to": 0,
                "from": 600
              },
              "model": {
                "refId": "A",
                "expr": "histogram_quantile(0.95, sum by(le)(rate(http_server_request_duration_seconds_bucket{service_name=\"diraigent-api\",http_route!~\"/health.*\"}[5m]))) or vector(0)",
                "instant": true,
                "range": false,
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "type": "query",
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        2
                      ]
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "B"
                      ]
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "Alerting",
          "execErrState": "Alerting",
          "for": "5m",
          "labels": {
            "service": "diraigent-api",
            "severity": "warning"
          },
          "annotations": {
            "summary": "Diraigent API p95 latency high"
          }
        }
      ]
    }
  ]
}
